# Cloudflare Bindings - set via wrangler.toml / dashboard
# D1: DB
# R2: R2, R2_PREVIEW

# Secrets - set via `wrangler secret put <NAME>`
JWT_SECRET= # openssl rand -base64 48
SESSION_SECRET= # openssl rand -base64 48
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
RESEND_API_KEY= # optional email
CRON_SECRET= # for manual cron trigger protection

# Vars
ENVIRONMENT=production
APP_NAME=FileDrop
APP_URL=https://filedrop.example.com
MAX_FILE_SIZE_MB=2048
MAX_FILES_PER_TRANSFER=50
DEFAULT_EXPIRY_DAYS=7
GUEST_EXPIRY_DAYS=3

# Abuse / Rate Limit
RATE_LIMIT_UPLOADS_PER_HOUR=20
RATE_LIMIT_DOWNLOADS_PER_HOUR=100
